# ── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_USER=sso_user
DB_PASS=change_me_strong_password
DB_NAME=sso_db

# ── SSO Signing Key ──────────────────────────────────────────────────────────
KEY_STORE_PATH=/root/.vault-sso/signing
KEY_STORE_PASSWORD=change_me_keystore_password

# ── Public URL ───────────────────────────────────────────────────────────────
# Used as the JWT issuer base — must match what nginx exposes.
# Tenant-scoped issuer will be: {ISSUER_BASE_URL}/{tenant}
# e.g. http://buildwithkulshresth.com/acme
ISSUER_BASE_URL=http://buildwithkulshresth.com
